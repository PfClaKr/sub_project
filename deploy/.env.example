# Copy to deploy/.env on the server (cp deploy/.env.example deploy/.env)
# and fill in. deploy/.env is git-ignored; never commit it.

# --- Site -----------------------------------------------------------------
# Domain pointing at the server's static IP (A record). Caddy gets the
# certificate from Let's Encrypt on the first request.
DOMAIN=itnyang.example.com
APP_URL=https://itnyang.example.com
# Let's Encrypt account contact (expiry notices).
ACME_EMAIL=you@example.com

# Long random string, e.g. `openssl rand -base64 48`. Changing it logs
# everyone out.
JWT_SECRET=

# --- AWS (deploy/aws-setup.sh prints these) -------------------------------
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Mail (Amazon SES SMTP, see deploy/README.md) --------------------------
SMTP_HOST=email-smtp.eu-west-3.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@itnyang.example.com
# false lets people log in without clicking the mail link (only while mail
# is not set up yet).
REQUIRE_EMAIL_VERIFICATION=true

# --- Optional ---------------------------------------------------------------
# Google login; the redirect URL to register is
# ${APP_URL}/svc/auth/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Elasticsearch heap. 512m fits a 2GB host; lower to 384m if memory is tight.
ES_HEAP=512m
