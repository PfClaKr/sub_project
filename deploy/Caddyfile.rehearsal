# Rehearsal copy of Caddyfile (docker-compose.rehearsal.yml) with a /media
# route to MinIO. Keep the rest identical to Caddyfile.
#
# One origin for everything: the session cookie is host-only, so the Go
# services live under /svc/* on the same domain as the site (no CORS, one
# certificate). handle_path strips the prefix before proxying.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	handle_path /svc/api/* {
		reverse_proxy apiserver:8080
	}
	handle_path /svc/auth/* {
		reverse_proxy loginserver:7070
	}
	# Websockets are proxied transparently.
	handle_path /svc/chat/* {
		reverse_proxy chatserver:9090
	}
	# Rehearsal only: uploaded photos from MinIO on the same origin.
	handle_path /media/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy nextjs:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
